# ==============================================================================
# Telegram Bot 設定 (必填)
# ==============================================================================
# 透過 @BotFather 取得的 Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 允許操作指令與接收推播的 Chat ID (可設定多組，以半形逗號分隔，例如: 12345678,87654321)
TELEGRAM_CHAT_ID=your_chat_id_here

# ==============================================================================
# 監控看板與關鍵字設定
# ==============================================================================
# PTT 監控看板 (以逗號分隔，例如: Stock,Lifeismoney,Gossiping)
PTT_BOARDS=Stock,Lifeismoney,Gossiping
# Dcard 監控看板 (以逗號分隔，例如: stock,tech_job)
DCARD_BOARDS=stock,tech_job
# 初始預設關鍵字 (若資料庫無任何關鍵字時自動匯入，以逗號分隔)
DEFAULT_KEYWORDS=台積電,美股,優惠,買一送一,分紅

# ==============================================================================
# 爆文與熱門門檻設定
# ==============================================================================
# PTT 爆文推文數門檻 (設為 0 則只要推文標記為「爆」即觸發；若大於 0 則推文數達到此值亦觸發)
PTT_MIN_PUSH_COUNT=50
# Dcard 最少按讚數門檻 (達標即觸發熱門推播)
DCARD_MIN_LIKE_COUNT=50

# ==============================================================================
# 爬蟲輪詢與系統設定
# ==============================================================================
# 每次輪詢之間的隨機延遲時間 (秒)
POLL_INTERVAL_MIN_SEC=30
POLL_INTERVAL_MAX_SEC=60

# 資料庫路徑
DB_PATH=./data/monitor.db
# 日誌等級 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# Dcard 進階選填設定 (如遇 Cloudflare 阻擋可填入 Cookie 或 Proxy)
# ==============================================================================
# DCARD_COOKIE=
# DCARD_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
